# Local shared PostgreSQL development backend runs with no external services.
# To use Supabase: apply supabase/migrations, then set BOTH values below.
# Never put a service_role/secret key here. Use the publishable/anon public key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# PUBLIC_ORIGIN=https://your-domain.example
PORT=4173

# Shader DNA: server-only, never prefix these with VITE_.
# Copy this file to .env for local development; configure Edge Function secrets in Supabase.
OPENROUTER_API_KEY=
DNA_MODELS=google/gemini-2.5-flash-lite,qwen/qwen3-30b-a3b-instruct-2507
